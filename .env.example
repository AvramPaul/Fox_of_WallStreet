# Copiază în .env și completează. Dacă ai rulat `ant auth login`, cheia API nu e necesară.
ANTHROPIC_API_KEY=

# Model și efort de gândire (low | medium | high | xhigh | max)
MODEL=claude-opus-5-5
EFFORT=high

# Limita de iterații ale buclei ReAct
MAX_ITERATIONS=40

# Opțional: ridică limita GitHub Search de la 10 la 30 req/min
GITHUB_TOKEN=
